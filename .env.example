# Copy this file to `.env` and fill in your key.
# The real `.env` is gitignored and must NEVER be committed.
# On Vercel, set these as Environment Variables in the project settings instead.

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model. Default is gemini-2.5-flash.
# (Note: some models like gemini-2.0-flash have no free-tier quota in the EU.)
# GEMINI_MODEL=gemini-2.5-flash
